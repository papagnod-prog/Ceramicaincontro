# Client-side routing fallback for the React SPA served at /store
# Scoped to this folder only — does not affect the WordPress site at the domain root.
RewriteEngine On
RewriteBase /store/

# Serve real files/folders (JS, CSS, images, etc.) directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else under /store falls back to index.html so React Router can handle it
RewriteRule ^ index.html [L]
